    <None Remove="Checks\**;installer\**;dist\**;SAVE_EXAMPLES\**;App_Data\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Saves/RenpyMod/*.rpy" LogicalName="RenpyMod.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
