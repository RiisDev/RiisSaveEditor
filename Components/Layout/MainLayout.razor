@inherits LayoutComponentBase
@inject RiisSaveEditor.UpdateChecker Updates

@if (Updates.UpdateAvailable)
{
    <div class="update-banner">
        Version @Updates.Latest is available (you are on @UpdateChecker.CurrentText).
        <a href="@Updates.LatestUrlHtml" target="_blank" rel="noopener noreferrer">View release</a>
    </div>
}

<nav class="nav-container">
    <div class="nav-links">
        <NavLink href="" Match="NavLinkMatch.All">Save Editor</NavLink>
        <NavLink href="renpy-cheats">RenPy Cheats</NavLink>
        <a href="https://github.com/RiisDev/RiisSaveEditor" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
</nav>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
